StructAlign(Server,OSI,EUI48){
    union {
        u8 bytes[6];
        struct __attribute__((packed)){
#if IS_LITTLE_ENDIAN
            u8 ig:1,ul:1,res:6;
#else
            u8 res:6,ul:1,ig:1;
#endif
        }information;
    } data;
};

