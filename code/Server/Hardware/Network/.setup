#pragma once
#include "../../.setup"


StructMemory(Server,Hardware,Network);

StructMemory(Server,Hardware,Network){
    StructHelp(Server,Common,Sync) scs;
    u16 id;
    struct net_device*dev;
    netdev_features_t features_old,wanted_features_old,gso_partial_features_old;
    struct packet_type pt;
    struct list_head node,shnd_node;
};

StructMemory(Server,Hardware,Network,Receive){
    StructMemory(Server,Hardware,Network)*shn;
    struct sk_buff*skb;
    struct work_struct thread;
};

Fn(StructMemory(Server,Hardware,Network)*,Server,Hardware,Network,Get,Or,Null)(u16 id);
Fn(bool,Server,Hardware,Network,Use)(StructMemory(Server,Hardware,Network)*shn);
Fn(void,Server,Hardware,Network,Release)(StructMemory(Server,Hardware,Network)*shn);

FnNew(Server,Hardware,Network)(StructMemory(Server,Hardware,Network)*shn);


#define NetworkAdapterGet(id)\
    Call(Server,Hardware,Network,Get,Or,Null)(id)

#define NetworkAdapterNew(shn)\
    New(Server,Hardware,Network)(shn)

#define NetworkAdapterUse(shn)\
    Call(Server,Hardware,Network,Use)(shn)

#define NetworkAdapterRelease(shn)\
    Call(Server,Hardware,Network,Release)(shn)
