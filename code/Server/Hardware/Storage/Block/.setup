Fn(StructMemory(Server,Hardware,Storage,Block)*,Server,Hardware,Storage,Block,Get)(u16 storageid,u64 blockid);
Fn(StructMemory(Server,Hardware,Storage,Block)*,Server,Hardware,Storage,Block,New)(u16 storageid);
